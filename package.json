{
  "name": "rodzina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "android:sync": "node scripts/android.mjs sync",
    "android:debug": "node scripts/android.mjs debug",
    "android:release": "node scripts/android.mjs release && node scripts/package-android.mjs",
    "android:package": "node scripts/package-android.mjs",
    "android:check-signing": "node scripts/android.mjs check-signing",
    "android:release:interactive": "node scripts/sign-android.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run build --workspace @rodzina/shared && tsx watch --env-file=apps/api/.env apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace @rodzina/web",
    "start": "node --env-file=apps/api/.env --input-type=module -e \"process.env.NODE_ENV = 'production'; process.env.RODZINA_ENV_FILE = 'apps/api/.env'; await import('./apps/api/server.cjs')\"",
    "job:backup": "node --env-file=apps/api/.env apps/api/dist/jobs/backup-db.js",
    "build": "npm run build --workspace @rodzina/shared && npm run build --workspace @rodzina/web && npm run build --workspace @rodzina/api",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path .gitignore \"AGENTS.md\" \"README.md\" \".prettierrc.json\" \"package*.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".github/workflows/*.yml\" \"docs/DECISIONS.md\" \"docs/DEVELOPMENT.md\" \"docs/DEPLOY.md\" \"docs/plan.md\" \"docs/ARCHITECTURE.md\" \"docs/DOKUMENTACJA_RAPORT.md\" \"docs/REDESIGN_PLAN.md\" \"docs/RESET_HASLA_PLAN.md\" \"docs/archive/*.md\" \"scripts/*.mjs\" \"packages/**/*.json\" \"packages/**/*.ts\" \"apps/**/*.json\" \"apps/**/*.cjs\" \"apps/**/*.ts\" \"apps/**/*.tsx\" \"apps/**/*.html\" \"playwright.config.ts\" \"e2e/**/*.ts\" \"capacitor.config.ts\"",
    "format:check": "prettier --check --ignore-path .gitignore \"AGENTS.md\" \"README.md\" \".prettierrc.json\" \"package*.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".github/workflows/*.yml\" \"docs/DECISIONS.md\" \"docs/DEVELOPMENT.md\" \"docs/DEPLOY.md\" \"docs/plan.md\" \"docs/ARCHITECTURE.md\" \"docs/DOKUMENTACJA_RAPORT.md\" \"docs/REDESIGN_PLAN.md\" \"docs/RESET_HASLA_PLAN.md\" \"docs/archive/*.md\" \"scripts/*.mjs\" \"packages/**/*.json\" \"packages/**/*.ts\" \"apps/**/*.json\" \"apps/**/*.cjs\" \"apps/**/*.ts\" \"apps/**/*.tsx\" \"apps/**/*.html\" \"playwright.config.ts\" \"e2e/**/*.ts\" \"capacitor.config.ts\"",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p apps/api/tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p tsconfig.e2e.json && tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck capacitor.config.ts",
    "test": "vitest run --config apps/web/vite.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config apps/api/drizzle.config.ts",
    "release": "npm run build && node scripts/build-release.mjs",
    "release:smoke": "node scripts/build-release.mjs && node scripts/smoke-release.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fflate": "^0.8.2",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  }
}
