# Konfiguracja komputera budującego APK; nie jest plikiem środowiska API.
# Domyślnie APK korzysta z produkcyjnego API HTTPS.
RODZINA_ANDROID_API_ORIGIN=https://rodzina.preficze.pl
# Lokalny debug: http://localhost:3000 oraz adb reverse tcp:3000 tcp:3000.
# Release odrzuca adres HTTP również po stronie kodu natywnego.
# JAVA_HOME i ANDROID_HOME ustaw na lokalne JDK 21 i Android SDK 36.
# Release: ścieżka bezwzględna do keystore POZA repo; hasła ustawiaj tylko w bieżącej sesji.
# RODZINA_ANDROID_KEYSTORE=C:/Users/<user>/rodzina-signing/rodzina-release.jks
# RODZINA_ANDROID_KEY_ALIAS=rodzina
# RODZINA_ANDROID_STORE_PASSWORD= (sekret, nie zapisuj tutaj)
# RODZINA_ANDROID_KEY_PASSWORD= (sekret, nie zapisuj tutaj)
