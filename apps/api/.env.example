# Tryb pracy: development albo production.
# APK nie wymaga dodatkowej konfiguracji API ani CORS. Konfiguracja budowania: /.env.android.example.
NODE_ENV=development
# Ścieżka do pliku bazy SQLite; katalog zostanie utworzony automatycznie.
RODZINA_DATABASE_PATH=./apps/api/data/rodzina.db
# Katalog kopii SQLite; job:backup tworzy go i zachowuje 14 ostatnich kopii dziennych.
RODZINA_BACKUP_DIR=./apps/api/data/backups
# Katalog zbudowanego frontendu (w paczce release domyślnie ./public).
RODZINA_WEB_DIR=../web/dist
# Adres linków zaproszeń i resetu hasła. W dev użyj portu 5173, przy npm start 3000.
RODZINA_PUBLIC_URL=http://localhost:5173
# Zezwala na założenie rodziny. Po rejestracji na serwerze ustaw false i zrestartuj aplikację.
RODZINA_ALLOW_REGISTRATION=true
# Publiczne odciski SHA-256 certyfikatów APK dla Android App Links, rozdzielone przecinkami.
# Format każdego odcisku: 32 pary hex rozdzielone dwukropkiem. Puste wyłącza weryfikację linków.
RODZINA_ANDROID_SHA256_CERT_FINGERPRINTS=
# Trwały katalog APK i latest.json poza aplikacją/public; puste oznacza brak wydania.
RODZINA_ANDROID_DOWNLOAD_DIR=
# Adresy IP/CIDR zaufanych proxy, rozdzielone przecinkami. Puste ignoruje X-Forwarded-For.
# Uzupełnij dopiero po potwierdzeniu łańcucha proxy u operatora hostingu.
RODZINA_TRUSTED_PROXIES=
# Reset przez e-mail domyślnie wyłączony. Włączenie wymaga pełnej konfiguracji SMTP poniżej.
RODZINA_PASSWORD_RESET_EMAIL_ENABLED=false
RODZINA_SMTP_HOST=
# 587 + SECURE=false wymusza STARTTLS; 465 + SECURE=true używa TLS od początku.
RODZINA_SMTP_PORT=587
RODZINA_SMTP_SECURE=false
RODZINA_SMTP_USER=
RODZINA_SMTP_PASSWORD=
# Sam adres istniejącej skrzynki nadawczej, bez nazwy wyświetlanej; nazwa wiadomości to Rodzina.
RODZINA_MAIL_FROM=
